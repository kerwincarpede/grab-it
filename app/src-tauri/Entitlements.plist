<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Tauri signs with the hardened runtime, which turns the camera and
	     microphone off unless the signature asks for them. Without these,
	     macOS refuses both without ever showing its prompt, and the webcam
	     bubble says "Camera not allowed". -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
