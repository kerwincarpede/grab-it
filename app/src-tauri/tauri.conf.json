{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grab-it",
  "version": "0.2.0",
  "identifier": "com.kerwincarpede.grabit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Screenshot, annotate, record and search your captures",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRERUVDNjY5MUI4OTdGQkQKUldTOWY0a2JhY2J1VFNpbHpxemlWNG9lMGV6VG40RFhqR1REQnAyZTBLSzdWL0U2a1JuZEhGLzYK",
      "endpoints": [
        "https://github.com/kerwincarpede/grab-it/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
