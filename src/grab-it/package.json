{
  "name": "grab-it",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . && tsc --noEmit && tsc -p e2e --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "bindings": "cargo test --manifest-path src-tauri/Cargo.toml --lib -- --ignored --exact tests::export_bindings",
    "tauri": "tauri",
    "e2e": "tauri build --debug --no-bundle --features e2e && npm run e2e:run",
    "e2e:run": "wdio run e2e/wdio.conf.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "konva": "^10.9.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-konva": "^19.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "@wdio/cli": "^9.33.1",
    "@wdio/globals": "^9.33.1",
    "@wdio/local-runner": "^9.33.1",
    "@wdio/mocha-framework": "^9.33.1",
    "@wdio/spec-reporter": "^9.33.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.0.16",
    "vitest": "^5.1.0"
  }
}
