---
// The hero: headline, calls to action and a demo of one first run of the app
// (HeroDemo.astro), then the three keys it takes.
import HeroDemo from './HeroDemo.astro';

const keycap =
	"flex: none; min-width: 64px; text-align: center; font-family: var(--gi-font-mono); font-size: 13px; font-weight: 600; color: var(--gi-text); padding: 10px 12px; border-radius: 10px; border: 1px solid var(--gi-hair-strong); background: linear-gradient(180deg, var(--gi-fill), transparent), var(--gi-panel); box-shadow: inset 0 -3px 0 var(--gi-hair-strong), 0 6px 16px rgb(0 0 0 / 18%);";
---

<section id="top" style="position: relative; z-index: 1; max-width: 1200px; margin: 0 auto; padding: clamp(64px, 9vw, 120px) clamp(16px, 4vw, 40px) 0; text-align: center">
<a href="https://github.com/kerwincarpede/grab-it/releases/latest" class="gi-link" style="display: inline-flex; align-items: center; gap: 10px; font-size: 13.5px; color: var(--gi-muted); text-decoration: none; border: 1px solid var(--gi-hair); background: var(--gi-glass); border-radius: 999px; padding: 6px 14px 6px 8px">
<span style="font-family: var(--gi-font-mono); font-size: 11px; font-weight: 600; color: var(--gi-on-cta); background: var(--gi-cta); border-radius: 999px; padding: 2px 8px">FREE</span>
Open source for Windows, macOS and Linux <span aria-hidden="true">→</span>
</a>
<h1 style="margin: 28px auto 0; max-width: 1000px; font-size: clamp(46px, 8.2vw, 104px); line-height: 0.98; letter-spacing: -0.045em; font-weight: 650">Screenshot it.<br><span style="background: linear-gradient(92deg, var(--gi-h1a) 0%, var(--gi-h1b) 55%, var(--gi-h1c) 100%); -webkit-background-clip: text; background-clip: text; color: transparent">Mark it up.</span> Paste it anywhere.</h1>
<p style="margin: 28px auto 0; font-size: clamp(17px, 1.7vw, 21px); color: var(--gi-muted); max-width: 580px">One key to capture, a few clicks to explain, and it's already on your clipboard.</p>
<div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 36px">
<a class="gi-cta" href="#download" style="text-decoration: none; background: var(--gi-cta); color: var(--gi-on-cta); font-weight: 650; padding: 0 22px; border-radius: 11px; min-height: 52px; box-sizing: border-box; display: inline-flex; align-items: center; gap: 10px; font-size: 16.5px; box-shadow: inset 0 1px 0 rgb(255 255 255 / 35%), 0 10px 40px var(--gi-glow)">
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"></path></svg>
<span data-gi-download-label>Download Grab-it</span>
</a>
<a class="gi-cta" href="/grab-it/get-started/" style="text-decoration: none; background: var(--gi-glass); border: 1px solid var(--gi-hair-strong); font-weight: 600; padding: 0 22px; border-radius: 11px; min-height: 52px; box-sizing: border-box; display: inline-flex; align-items: center; font-size: 16.5px">Read the docs</a>
</div>

<figure style="position: relative; margin: clamp(56px, 7vw, 88px) auto 0; max-width: 1060px">
<div aria-hidden="true" style="position: absolute; inset: 8% 4% -6% 4%; background: radial-gradient(closest-side, var(--gi-glow), transparent); filter: blur(40px)"></div>
<div style="position: relative; padding: 1px; border-radius: 20px; background: linear-gradient(180deg, var(--gi-hair-strong), var(--gi-hair) 40%, transparent)">
<HeroDemo />
</div>
</figure>

<ol aria-label="How it works" style="list-style: none; margin: 56px auto 0; padding: 0; max-width: 900px; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; text-align: left">
<li style="display: flex; align-items: center; gap: 14px; padding: 16px; border-radius: 14px; border: 1px solid var(--gi-hair); background: var(--gi-glass)">
<kbd style={keycap}>PrtSc</kbd>
<span><span style="display: block; font-weight: 650">Capture</span><span style="font-size: 13.5px; color: var(--gi-muted)">or ⌘ ⇧ 2 on a Mac</span></span>
</li>
<li style="display: flex; align-items: center; gap: 14px; padding: 16px; border-radius: 14px; border: 1px solid var(--gi-hair); background: var(--gi-glass)">
<kbd style={keycap}>Drag</kbd>
<span><span style="display: block; font-weight: 650">Select</span><span style="font-size: 13.5px; color: var(--gi-muted)">a region or a window</span></span>
</li>
<li style="display: flex; align-items: center; gap: 14px; padding: 16px; border-radius: 14px; border: 1px solid var(--gi-hair); background: var(--gi-glass)">
<kbd style={keycap}>Ctrl V</kbd>
<span><span style="display: block; font-weight: 650">Paste</span><span style="font-size: 13.5px; color: var(--gi-muted)">it's already copied</span></span>
</li>
</ol>
</section>

<script>
	import { detectOs, osNames } from './os';

	const os = detectOs();
	const label = document.querySelector('[data-gi-download-label]');
	if (os && label) label.textContent = `Download for ${osNames[os]}`;
</script>
