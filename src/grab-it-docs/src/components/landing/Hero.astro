---
// The hero: a headline that marks itself up (a box and a numbered step are
// drawn round "Mark it."), the calls to action, the demo of one first run
// of the app (HeroDemo.astro), which leans back in space and settles flat as
// it scrolls in, and the three keys it takes.
import HeroDemo from './HeroDemo.astro';
---

<section class="gi-hero" data-hue="capture">
	<p class="gi-eyebrow gi-in" style="--d: 0">Free and open source</p>
	<h1 class="gi-title">
		<span class="gi-in" style="--d: 1">Capture it.</span>
		<span class="gi-in gi-mark" style="--d: 2">
			Mark it.
			<svg class="gi-mark-box" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
				<rect x="1" y="3" width="98" height="94" rx="6" pathLength="1"></rect>
			</svg>
			<span class="gi-mark-step" aria-hidden="true">1</span>
		</span>
		<span class="gi-in" style="--d: 3">Paste it.</span>
	</h1>
	<p class="gi-lede gi-in" style="--d: 4">The screenshot tool for Windows, macOS and Linux. One key to capture, a few clicks to explain, and it's already on your clipboard.</p>
	<div class="gi-ctas gi-in" style="--d: 5">
		<a class="gi-btn" href="#download">
			<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"></path></svg>
			<span data-download-label>Download Grab-it</span>
		</a>
		<a class="gi-btn gi-btn--ghost" href="/grab-it/get-started/">Read the docs <span aria-hidden="true">→</span></a>
	</div>

	<figure class="gi-demo" data-tilt>
		<HeroDemo />
	</figure>

	<p class="gi-keys" data-reveal>
		<span data-reveal-child><kbd>PrtSc</kbd> or <kbd>⌘ ⇧ 2</kbd> to capture</span>
		<span class="gi-keys-sep" aria-hidden="true" data-reveal-child></span>
		<span data-reveal-child>drag a region or click a window</span>
		<span class="gi-keys-sep" aria-hidden="true" data-reveal-child></span>
		<span data-reveal-child><kbd>Ctrl V</kbd> anywhere: it's already copied</span>
	</p>
</section>

<script>
	import { onScrollProgress } from './reveal';
	import { detectOs, osNames } from './os';

	// The demo leans back in space and settles flat as it scrolls in.
	const tilt = document.querySelector<HTMLElement>('[data-tilt]');
	if (tilt && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		onScrollProgress(tilt, (p) => tilt.style.setProperty('--p', p.toFixed(4)), { start: 1.15, end: 0.55 });
	}

	const os = detectOs();
	const label = document.querySelector('[data-download-label]');
	if (os && label) label.textContent = `Download for ${osNames[os]}`;
</script>

<style>
	.gi-hero {
		max-width: 1200px;
		margin: 0 auto;
		padding: clamp(72px, 11vw, 150px) clamp(16px, 4vw, 40px) 0;
		text-align: center;
	}
	.gi-eyebrow {
		margin: 0;
		font-size: 14px;
		color: var(--gi-muted);
	}
	.gi-title {
		margin: 22px auto 0;
		font-size: clamp(46px, 8.4vw, 112px);
		line-height: 0.98;
		letter-spacing: -0.05em;
		font-weight: 600;
	}
	.gi-title > span {
		display: inline-block;
	}
	.gi-title > span:last-child {
		display: block;
	}
	/* The headline marks itself up, like a capture in the editor. */
	.gi-mark {
		position: relative;
		margin: 0 0.12em;
		padding: 0 0.1em;
	}
	.gi-mark-box {
		position: absolute;
		inset: -0.02em -0.08em -0.06em;
		width: calc(100% + 0.16em);
		height: calc(100% + 0.08em);
		overflow: visible;
		pointer-events: none;
	}
	.gi-mark-box rect {
		fill: none;
		stroke: var(--gi-hue-editor);
		stroke-width: 3px;
		vector-effect: non-scaling-stroke;
		stroke-dasharray: 1;
		stroke-dashoffset: 1;
		animation: gi-draw 1.1s cubic-bezier(0.65, 0, 0.35, 1) 1.25s forwards;
	}
	.gi-mark-step {
		position: absolute;
		right: -0.42em;
		top: -0.3em;
		width: 0.42em;
		height: 0.42em;
		border-radius: 50%;
		background: var(--gi-hue-editor);
		color: #16080a;
		font-size: 0.26em;
		font-weight: 700;
		letter-spacing: 0;
		line-height: 1.6em;
		display: grid;
		place-items: center;
		transform: scale(0);
		animation: gi-pop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 2.15s forwards;
	}
	@keyframes gi-draw {
		to {
			stroke-dashoffset: 0;
		}
	}
	@keyframes gi-pop {
		to {
			transform: scale(1);
		}
	}
	.gi-ctas {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 12px;
		margin-top: 36px;
	}
	/* The entrance: each line rises out of a soft blur, one after another. */
	.gi-in {
		opacity: 0;
		transform: translateY(18px);
		filter: blur(8px);
		animation: gi-rise 1s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
		animation-delay: calc(var(--d) * 110ms + 150ms);
	}
	@keyframes gi-rise {
		to {
			opacity: 1;
			transform: none;
			filter: none;
		}
	}

	.gi-demo {
		--p: 1;
		margin: clamp(64px, 8vw, 104px) auto 0;
		max-width: 1080px;
		perspective: 1400px;
		opacity: 0;
		animation: gi-fade 1.4s ease 0.9s forwards;
	}
	.gi-demo :global(.gi-hd-stage) {
		transform: rotateX(calc((1 - var(--p)) * 24deg)) scale(calc(0.9 + var(--p) * 0.1));
		transform-origin: 50% 0%;
		box-shadow:
			0 0 0 1px var(--gi-hair-strong),
			0 50px 120px -20px color-mix(in srgb, var(--gi-accent) calc(var(--p) * 30%), transparent);
		will-change: transform;
	}
	@keyframes gi-fade {
		to {
			opacity: 1;
		}
	}
	.gi-keys {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 10px 18px;
		margin: 56px auto 0;
		color: var(--gi-muted);
		font-size: 15px;
	}
	.gi-keys kbd {
		display: inline-block;
		margin: 0 2px;
		padding: 3px 8px;
		border-radius: 7px;
		font-size: 12.5px;
		color: var(--gi-text);
		box-shadow: inset 0 0 0 1px var(--gi-hair-strong), inset 0 -2px 0 var(--gi-hair-strong);
	}
	.gi-keys-sep {
		width: 28px;
		height: 1px;
		background: var(--gi-hair-strong);
	}

	@media (prefers-reduced-motion: reduce) {
		.gi-in {
			transform: none;
			filter: none;
			animation-duration: 0.6s;
		}
		.gi-mark-box rect,
		.gi-mark-step {
			animation-duration: 0.01s;
		}
	}
</style>
