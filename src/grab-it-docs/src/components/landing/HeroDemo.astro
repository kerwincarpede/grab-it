---
// The hero's demo: one first run of the app, drawn in HTML and played from a
// single timeline (hero/timeline.ts). PrtSc, a drag around a chart, let go, the
// capture lifts off the screen into the Quick Access card, Annotate flies it
// into the editor, an arrow is drawn and Copy lifts the result free. The
// pointer drives the selection and the arrow, so it stays on them. Without
// JavaScript the scene shows its poster: the editor with the finished arrow.
import { sceneHTML } from './hero/scene';
import './hero/scene.css';

const steps = ['Press PrtSc and drag around the chart', "Let go. It's copied and saved", 'Click Annotate and draw an arrow', 'Copy it, then paste it anywhere'];
---

<div class="gi-hd" data-hero-demo>
	<div
		class="gi-hd-stage"
		data-hero-stage
		role="img"
		aria-label="Animation: PrtSc is pressed and a region is dragged around a sales chart. On letting go, the capture lifts off the screen into the Quick Access card. Annotate flies it into the image editor, an arrow is drawn to this week's bar, and Copy copies the result."
		set:html={sceneHTML()}
	/>
	<div class="gi-hd-controls" data-hero-controls hidden>
		<div class="gi-hd-buttons">
			<button type="button" class="gi-hd-btn" data-hero-play aria-label="Pause animation"></button>
			<button type="button" class="gi-hd-btn" data-hero-replay aria-label="Replay from the start">
				<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.4-5.7M4 4v4.5h4.5"></path></svg>
			</button>
		</div>
		<ol class="gi-hd-steps" aria-label="Steps in the animation">
			{
				steps.map((label, i) => (
					<li>
						<button type="button" data-hero-step>
							<span class="gi-hd-n">{i + 1}</span>
							<span>{label}</span>
							<span class="gi-hd-bar" aria-hidden="true" />
						</button>
					</li>
				))
			}
		</ol>
	</div>
</div>

<style>
	.gi-hd {
		display: flex;
		flex-direction: column;
		gap: 14px;
	}
	.gi-hd-controls {
		display: flex;
		gap: 10px;
		align-items: stretch;
		text-align: left;
	}
	.gi-hd-controls[hidden] {
		display: none;
	}
	.gi-hd-buttons {
		display: flex;
		gap: 8px;
		flex: none;
	}
	.gi-hd-btn {
		width: 44px;
		height: 44px;
		border-radius: 12px;
		border: 1px solid var(--gi-hair-strong);
		background: var(--gi-glass);
		color: var(--gi-text);
		display: inline-grid;
		place-items: center;
		cursor: pointer;
	}
	.gi-hd-btn:hover {
		background: var(--gi-accent-soft);
	}
	.gi-hd-steps {
		list-style: none;
		margin: 0;
		padding: 0;
		flex: 1;
		min-width: 0;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 8px;
	}
	.gi-hd-steps button {
		position: relative;
		width: 100%;
		height: 100%;
		min-height: 44px;
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 10px;
		align-items: center;
		padding: 8px 12px;
		border-radius: 12px;
		border: 1px solid var(--gi-hair);
		background: var(--gi-glass);
		color: var(--gi-muted);
		font: inherit;
		font-size: 13.5px;
		line-height: 1.3;
		text-align: left;
		cursor: pointer;
		overflow: hidden;
	}
	.gi-hd-steps button:hover {
		border-color: var(--gi-hair-strong);
	}
	.gi-hd-steps button.is-on {
		color: var(--gi-text);
		border-color: var(--gi-accent-edge);
		background: var(--gi-accent-soft);
	}
	.gi-hd-n {
		font-family: var(--gi-font-mono);
		font-size: 12px;
		font-weight: 600;
		width: 22px;
		height: 22px;
		border-radius: 7px;
		display: grid;
		place-items: center;
		border: 1px solid var(--gi-hair-strong);
		color: var(--gi-text);
	}
	.is-on .gi-hd-n {
		background: var(--gi-accent);
		color: var(--gi-on-accent);
		border-color: transparent;
	}
	.gi-hd-bar {
		position: absolute;
		left: 0;
		bottom: 0;
		width: 100%;
		height: 3px;
		background: var(--gi-accent);
		transform-origin: 0 0;
		transform: scaleX(0);
	}
	@media (max-width: 760px) {
		.gi-hd-controls {
			flex-direction: column;
		}
		.gi-hd-steps {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>

<script>
	import { startHeroDemos } from './hero/player';

	startHeroDemos();
</script>
