---
// The downloads: one column per system on a hairline. The visitor's own system
// is marked once the page has detected it. Each file line
// matches get-started/install.mdx, and every link goes to the latest release.
const release = 'https://github.com/kerwincarpede/grab-it/releases/latest';

const systems = [
	{ id: 'windows', name: 'Windows', files: 'Setup (.exe) or .msi · Windows 10 and 11' },
	{ id: 'macos', name: 'macOS', files: 'Disk image (.dmg) · Apple silicon or Intel' },
	{ id: 'linux', name: 'Linux', files: '.deb, .rpm and AppImage' },
];
---

<section id="download" class="gi-download" data-hue="capture" aria-labelledby="gi-dl-title">
	<h2 id="gi-dl-title" class="gi-h2" data-reveal>
		<span data-reveal-child>Your next screenshot</span>
		<span data-reveal-child>is one key away.</span>
	</h2>
	<p class="gi-lede" data-reveal>Free and open source. Pick the installer for your computer.</p>
	<ul class="gi-systems" data-reveal>
		{
			systems.map((s) => (
				<li data-reveal-child>
					<a href={release} data-os={s.id}>
						<span class="gi-sys-name">{s.name}</span>
						<span class="gi-sys-files">{s.files}</span>
						<span class="gi-sys-go">
							Download <span aria-hidden="true">→</span>
						</span>
					</a>
				</li>
			))
		}
	</ul>
	<p class="gi-dl-note" data-reveal>Then follow <a href="/grab-it/get-started/install/">Install</a>. Grab-it checks for updates by itself.</p>
</section>

<script>
	import { detectOs } from './os';

	const os = detectOs();
	if (os) document.querySelector(`[data-os="${os}"]`)?.classList.add('is-yours');
</script>

<style>
	.gi-download {
		max-width: 1200px;
		margin: 0 auto;
		padding: clamp(140px, 16vw, 220px) clamp(16px, 4vw, 40px) 0;
		text-align: center;
	}
	.gi-systems {
		list-style: none;
		margin: 56px auto 0;
		padding: 0;
		max-width: 980px;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		border-top: 1px solid var(--gi-hair-strong);
	}
	.gi-systems li + li {
		border-left: 1px solid var(--gi-hair);
	}
	.gi-systems a {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 6px;
		height: 100%;
		box-sizing: border-box;
		padding: 28px 24px 30px;
		text-align: left;
		text-decoration: none;
		transition: background 0.3s ease;
	}
	/* The top hairline fills in on hover, and stays filled for your system. */
	.gi-systems a::before {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		top: -1px;
		height: 1px;
		background: var(--gi-text);
		transform: scaleX(0);
		transform-origin: 0 0;
		transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
	}
	.gi-systems a:hover::before,
	.gi-systems a:global(.is-yours)::before {
		transform: scaleX(1);
	}
	.gi-systems a:hover {
		background: linear-gradient(180deg, var(--gi-fill), transparent);
	}
	.gi-sys-name {
		font-size: 22px;
		font-weight: 600;
		letter-spacing: -0.02em;
	}
	.gi-sys-files {
		font-size: 14px;
		color: var(--gi-muted);
	}
	.gi-sys-go {
		margin-top: auto;
		padding-top: 18px;
		font-weight: 600;
		font-size: 15px;
	}
	.gi-systems a:global(.is-yours) .gi-sys-go::after {
		content: ' · your computer';
		font-weight: 400;
		color: var(--gi-muted);
	}
	.gi-dl-note {
		margin: 32px 0 0;
		font-size: 14px;
		color: var(--gi-muted);
	}
	@media (max-width: 760px) {
		.gi-systems {
			grid-template-columns: 1fr;
		}
		.gi-systems li + li {
			border-left: 0;
			border-top: 1px solid var(--gi-hair);
		}
	}
</style>
