---
// The landing page's own layout: head, theme, the 3D field behind the page
// (field.ts), header and footer, and the scroll reveals (reveal.ts). Docs and
// reference pages keep Starlight's layout.
import '@fontsource-variable/instrument-sans';
import '@fontsource-variable/geist-mono';
import '../../styles/tokens.css';
import Logo from '../Logo.astro';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site);

const guide = [
	['Get started', '/grab-it/get-started/'],
	['Capture', '/grab-it/capture/'],
	['Image editor', '/grab-it/image-editor/'],
	['Recording', '/grab-it/recording/'],
	['Video editor', '/grab-it/video-editor/'],
	['Library', '/grab-it/library/'],
	['AI', '/grab-it/ai/'],
	['Reference', '/grab-it/reference/'],
	['Contribute', '/grab-it/contribute/'],
	['GitHub', 'https://github.com/kerwincarpede/grab-it'],
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta name="color-scheme" content="dark light" />
		{/* Before the first paint, as Starlight's ThemeProvider does: the theme
		    picked on a docs page wins, otherwise the system setting. */}
		<script is:inline>
			(() => {
				const stored = () => {
					try {
						return localStorage.getItem('starlight-theme');
					} catch {
						return null;
					}
				};
				const light = window.matchMedia('(prefers-color-scheme: light)');
				const apply = () => {
					const theme = stored() || (light.matches ? 'light' : 'dark');
					document.documentElement.dataset.theme = theme === 'light' ? 'light' : 'dark';
				};
				apply();
				light.addEventListener('change', apply);
			})();
		</script>
	</head>
	<body>
		<a class="gi-skip" href="#main">Skip to content</a>
		<canvas class="gi-field" aria-hidden="true" data-field></canvas>
		<div class="gi-vignette" aria-hidden="true"></div>

		<header class="gi-head" data-head>
			<a href="/grab-it/" class="gi-brand"><Logo id="gi-logo-header" size={24} /> Grab-it</a>
			<nav aria-label="Main" class="gi-nav">
				<a href="#tour">Tour</a>
				<a href="/grab-it/get-started/">Docs</a>
				<a href="/grab-it/reference/">Reference</a>
				<a href="https://github.com/kerwincarpede/grab-it">GitHub</a>
			</nav>
			<a class="gi-btn gi-btn--small" href="#download">Download</a>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="gi-foot">
			<p><Logo id="gi-logo-footer" size={20} /> MIT licensed. Made for people who explain things on screen.</p>
			<nav aria-label="Guide">
				{guide.map(([label, href]) => <a href={href}>{label}</a>)}
			</nav>
		</footer>
	</body>
</html>

<script>
	import { startReveals } from './reveal';

	startReveals();

	// The header gains its glass once the page has scrolled.
	const head = document.querySelector<HTMLElement>('[data-head]');
	const onScroll = () => head?.classList.toggle('is-stuck', window.scrollY > 24);
	window.addEventListener('scroll', onScroll, { passive: true });
	onScroll();

	// The 3D field loads after the page, so it never holds up the first paint.
	const canvas = document.querySelector<HTMLCanvasElement>('[data-field]');
	if (canvas) {
		const start = () => import('./field').then((m) => m.startField(canvas));
		if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 1500 });
		else setTimeout(start, 300);
	}
</script>

<style is:global>
	html {
		background: var(--gi-bg);
		scroll-behavior: smooth;
	}
	body {
		margin: 0;
		background: var(--gi-bg);
		color: var(--gi-text);
		font-family: var(--gi-font-sans);
		font-size: 16px;
		line-height: 1.55;
		-webkit-font-smoothing: antialiased;
		overflow-x: clip;
	}
	a {
		color: inherit;
	}
	:focus-visible {
		outline: 2px solid var(--gi-accent);
		outline-offset: 3px;
		border-radius: 4px;
	}
	kbd {
		font-family: var(--gi-font-mono);
	}

	/* Buttons, shared by the header, hero and downloads */
	.gi-btn {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		min-height: 50px;
		padding: 0 22px;
		border-radius: 999px;
		background: var(--gi-text);
		color: var(--gi-bg);
		font-weight: 650;
		font-size: 16px;
		text-decoration: none;
		box-sizing: border-box;
		transition: transform 0.25s ease, box-shadow 0.25s ease;
	}
	.gi-btn:hover {
		transform: translateY(-1px);
		box-shadow: 0 10px 36px color-mix(in srgb, var(--gi-accent) 35%, transparent);
	}
	.gi-btn--ghost {
		background: transparent;
		color: var(--gi-text);
		box-shadow: inset 0 0 0 1px var(--gi-hair-strong);
	}
	.gi-btn--ghost:hover {
		box-shadow: inset 0 0 0 1px var(--gi-text);
	}
	.gi-btn--small {
		min-height: 38px;
		padding: 0 16px;
		font-size: 14px;
	}

	/* Section headings: the second line is quieter */
	.gi-h2 {
		margin: 0 auto;
		text-align: center;
		font-size: clamp(36px, 5vw, 64px);
		line-height: 1.02;
		letter-spacing: -0.04em;
		font-weight: 600;
		text-wrap: balance;
	}
	.gi-h2 > span {
		display: block;
	}
	.gi-h2 > span + span {
		color: var(--gi-muted);
	}
	.gi-lede {
		margin: 26px auto 0;
		max-width: 560px;
		font-size: clamp(17px, 1.6vw, 20px);
		color: var(--gi-muted);
		text-wrap: balance;
	}

	/* The tour animations' pause and play button */
	.gi-tour-toggle {
		position: absolute;
		right: 10px;
		bottom: 10px;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		border: 1px solid rgb(255 255 255 / 18%);
		background: rgb(13 16 22 / 72%);
		color: #f3f4f7;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
		transition: background 0.2s ease;
	}
	.gi-tour-toggle:hover {
		background: rgb(13 16 22 / 90%);
	}

	/* Scroll reveals (reveal.ts): rise out of a soft blur, children one after
	   another. The hidden state only applies once the script has run. */
	[data-reveal],
	[data-reveal] [data-reveal-child] {
		transition:
			opacity 0.9s ease,
			transform 1s cubic-bezier(0.2, 0.7, 0.2, 1),
			filter 1s ease;
		transition-delay: calc(var(--i, 0) * 90ms);
	}
	.gi-reveals [data-reveal]:not(.is-in):not(:has([data-reveal-child])),
	.gi-reveals [data-reveal]:not(.is-in) [data-reveal-child] {
		opacity: 0;
		transform: translateY(22px);
		filter: blur(6px);
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
		.gi-reveals [data-reveal],
		.gi-reveals [data-reveal] [data-reveal-child] {
			transform: none !important;
			filter: none !important;
			transition: opacity 0.5s ease !important;
		}
		.gi-btn:hover {
			transform: none;
		}
	}
</style>

<style>
	/* The field sits behind everything, fading in once it has drawn. */
	.gi-field {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
		pointer-events: none;
		opacity: 0;
		transition: opacity 2.4s ease;
	}
	.gi-field:global(.is-on) {
		opacity: 1;
	}
	:global(.gi-field-dim) .gi-field:global(.is-on) {
		opacity: 0.4;
	}
	/* Keeps the text calm: darker down the middle and at the edges. */
	.gi-vignette {
		position: fixed;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		background:
			radial-gradient(ellipse 34% 60% at 50% 45%, color-mix(in srgb, var(--gi-bg) 55%, transparent), transparent 100%),
			radial-gradient(ellipse 120% 90% at 50% 40%, transparent 55%, var(--gi-bg) 100%);
	}
	.gi-head,
	main,
	.gi-foot {
		position: relative;
		z-index: 1;
	}
	.gi-skip {
		position: absolute;
		left: 16px;
		top: -100px;
		z-index: 50;
		background: var(--gi-text);
		color: var(--gi-bg);
		font-weight: 650;
		padding: 10px 16px;
		border-radius: 9px;
		text-decoration: none;
	}
	.gi-skip:focus {
		top: 16px;
	}

	.gi-head {
		position: sticky;
		top: 0;
		z-index: 20;
		display: flex;
		align-items: center;
		gap: 12px 28px;
		max-width: 1200px;
		margin: 0 auto;
		padding: 14px clamp(16px, 4vw, 40px);
		border-bottom: 1px solid transparent;
		transition: background 0.4s ease, border-color 0.4s ease;
	}
	.gi-head.is-stuck {
		max-width: none;
		background: color-mix(in srgb, var(--gi-bg) 72%, transparent);
		border-bottom-color: var(--gi-hair);
		-webkit-backdrop-filter: blur(16px) saturate(1.2);
		backdrop-filter: blur(16px) saturate(1.2);
	}
	.gi-brand {
		display: flex;
		align-items: center;
		gap: 10px;
		font-weight: 650;
		font-size: 17px;
		letter-spacing: -0.01em;
		text-decoration: none;
	}
	.gi-nav {
		display: flex;
		gap: 4px;
		flex: 1;
		font-size: 14.5px;
		color: var(--gi-muted);
	}
	.gi-nav a {
		text-decoration: none;
		padding: 8px 12px;
		border-radius: 8px;
		transition: color 0.2s ease;
	}
	.gi-nav a:hover {
		color: var(--gi-text);
	}
	@media (max-width: 640px) {
		.gi-nav {
			display: none;
		}
		.gi-head {
			justify-content: space-between;
		}
	}

	.gi-foot {
		max-width: 1200px;
		margin: clamp(120px, 14vw, 180px) auto 0;
		padding: 32px clamp(16px, 4vw, 40px) 48px;
		border-top: 1px solid var(--gi-hair);
		display: flex;
		flex-wrap: wrap;
		gap: 24px 48px;
		justify-content: space-between;
		font-size: 14px;
		color: var(--gi-muted);
	}
	.gi-foot p {
		margin: 0;
		display: flex;
		align-items: center;
		gap: 10px;
	}
	.gi-foot nav {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 20px;
	}
	.gi-foot a {
		text-decoration: none;
	}
	.gi-foot a:hover {
		color: var(--gi-text);
	}
</style>
