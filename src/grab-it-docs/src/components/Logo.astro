---
// The Grab-it mark: crop corners on a blue gradient tile.
interface Props {
	size?: number;
	id: string;
}
const { size = 26, id } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 26 26" aria-hidden="true" class="gi-logo">
	<defs>
		<linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
			<stop offset="0" stop-color="#97a9ff"></stop>
			<stop offset="1" stop-color="#5b6cf0"></stop>
		</linearGradient>
	</defs>
	<rect x="1" y="1" width="24" height="24" rx="7" fill={`url(#${id})`}></rect>
	<path
		d="M7 11V7h4M19 15v4h-4M15 7h4v4M11 19H7v-4"
		fill="none"
		stroke="#0b0c10"
		stroke-width="2.2"
		stroke-linecap="round"
		stroke-linejoin="round"
	></path>
</svg>
