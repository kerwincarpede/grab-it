+
+// Async: off the main thread, which `ps` would otherwise hold up for tens of
+// milliseconds, right as the next phase starts.
+#[tauri::command(async)]
+pub fn overlay_bench_log(line: String) {
+    eprintln!("BENCH {line}");
+    // Cumulative CPU seconds of WindowServer and of the WebKit GPU processes
+    // no older than this app, so each phase can be costed on its own.
+    let Ok(out) = std::process::Command::new("ps")
+        .args(["-axo", "pid=,etime=,time=,comm="])
+        .output()
+    else {
+        return;
+    };
+    let secs = |t: &str| {
+        t.replace('-', ":")
+            .split(':')
+            .fold(0.0, |v, x| v * 60.0 + x.parse::<f64>().unwrap_or(0.0))
+    };
+    let text = String::from_utf8_lossy(&out.stdout);
+    let rows: Vec<(u32, f64, f64, String)> = text
+        .lines()
+        .filter_map(|l| {
+            let mut f = l.split_whitespace();
+            let pid = f.next()?.parse().ok()?;
+            let etime = secs(f.next()?);
+            let time = secs(f.next()?);
+            Some((pid, etime, time, f.collect::<Vec<_>>().join(" ")))
+        })
+        .collect();
+    let mine = rows
+        .iter()
+        .find(|r| r.0 == std::process::id())
+        .map_or(f64::MAX, |r| r.1);
+    let ws: f64 = rows.iter().filter(|r| r.3.ends_with("WindowServer")).map(|r| r.2).sum();
+    let gpu: f64 = rows
+        .iter()
+        .filter(|r| r.3.contains("WebKit.GPU") && r.1 <= mine + 1.0)
+        .map(|r| r.2)
+        .sum();
+    let app: f64 = rows.iter().filter(|r| r.0 == std::process::id()).map(|r| r.2).sum();
+    eprintln!("BENCHCPU ws={ws:.2} gpu={gpu:.2} app={app:.2}");
+}
+
+#[tauri::command]
+pub fn overlay_bench_opaque(window: WebviewWindow) {
+    #[cfg(target_os = "macos")]
+    {
+        use objc2::runtime::{AnyClass, AnyObject};
+        let Ok(ns_window) = window.ns_window() else { return };
+        let ns_window = ns_window.cast::<AnyObject>();
+        unsafe {
+            let black: *mut AnyObject =
+                objc2::msg_send![AnyClass::get(c"NSColor").unwrap(), blackColor];
+            let _: () = objc2::msg_send![ns_window, setBackgroundColor: black];
+            let _: () = objc2::msg_send![ns_window, setOpaque: true];
+        }
+        eprintln!("BENCH opaque set");
+    }
+}
